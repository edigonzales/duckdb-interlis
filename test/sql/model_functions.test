# name: test/sql/model_functions.test
# description: native INTERLIS model introspection
# group: [sql]

require interlis

query II
SELECT component, version
FROM interlis_components()
WHERE component <> 'geos'
ORDER BY component;
----
duckdb	v1.5.5
duckdb-interlis	0.2.1
ilic	0.10.0-SNAPSHOT
iox-cpp	0.2.0

query I
SELECT version IN ('disabled', '3.14.1')
FROM interlis_components()
WHERE component = 'geos';
----
true

query II
SELECT component,
       regexp_full_match(revision, '[0-9a-f]{40}(-dirty)?') AS valid_revision
FROM interlis_components()
WHERE component IN ('duckdb-interlis', 'ilic', 'iox-cpp')
ORDER BY component;
----
duckdb-interlis	true
ilic	true
iox-cpp	true

query III
SELECT name, language, ili_version
FROM ili_models(['testdata/native/introspection.ili']);
----
NativeIntrospection	en	2.3

query II
SELECT class_fqn, kind
FROM ili_classes(['testdata/native/introspection.ili'], model := 'NativeIntrospection');
----
NativeIntrospection.Data.Feature	CLASS

query IIII
SELECT property_name, interlis_type, duckdb_type, is_transient
FROM ili_properties('NativeIntrospection.Data.Feature', ['testdata/native/introspection.ili']);
----
Name	TextType	VARCHAR	false
Geometry	LineType	GEOMETRY	false
AreaGeometry	LineType	GEOMETRY	false
LocalGeometry	LineType	GEOMETRY	false
