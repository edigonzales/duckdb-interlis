# name: test/sql/version.test
# description: native INTERLIS extension bootstrap
# group: [sql]

require interlis

query I
SELECT contains(interlis_version(), 'duckdb-interlis/0.2.0')
   AND contains(interlis_version(), 'ilic/0.10.0-SNAPSHOT')
   AND contains(interlis_version(), 'iox-cpp/0.2.0')
   AND (contains(interlis_version(), 'geos/disabled')
        OR contains(interlis_version(), 'geos/3.x'))
   AND contains(interlis_version(), 'duckdb/v1.5.');
----
true
