INTERLIS 2.3;

MODEL NativeIntrospection (en) AT "https://example.invalid" VERSION "1" =
  DOMAIN
    Coord2 = COORD
      0.00 .. 1000.00,
      0.00 .. 1000.00;

    SurfaceDomain = SURFACE WITH (STRAIGHTS, ARCS)
      VERTEX Coord2
      WITHOUT OVERLAPS > 0.02;

    AreaDomain = AREA WITH (STRAIGHTS)
      VERTEX Coord2;

  TOPIC Data =
    CLASS Feature =
      Name : TEXT*20;
      Geometry : SurfaceDomain;
      AreaGeometry : AreaDomain;
      LocalGeometry : POLYLINE WITH (STRAIGHTS) VERTEX Coord2;
    END Feature;
  END Data;
END NativeIntrospection.
